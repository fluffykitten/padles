# =============================================================================
# Padles Environment Configuration Template (.env.example)
# Copy this file to `.env.local` and fill in your values.
# `.env.local` is gitignored and will never be committed to source control.
# =============================================================================

# --- Supabase Database & Auth (PostgreSQL, Realtime, Sessions) ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_BOARD_ID=board-default-physics

# --- Cloudflare R2 Media Storage ($0 Egress Media Attachments) ---
R2_UPLOAD_ENDPOINT=https://padles-r2-uploader.yourname.workers.dev/
R2_PUBLIC_CDN=https://pub-xxxxxx.r2.dev
